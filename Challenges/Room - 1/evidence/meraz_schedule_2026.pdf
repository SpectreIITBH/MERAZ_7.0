    <div class="section">
        <h2>Day 2 — Saturday, 3 October 2026</h2>
        <table>
            <thead>
                <tr><th>Time</th><th>Event</th><th>Venue</th><th>Category</th></tr>
            </thead>
            <tbody>
                <tr><td class="time">04:00</td><td class="event-name">SPECTRE // NIGHTJAR — Incident Concludes</td><td class="venue">Lab Complex B</td><td>Cybersecurity</td></tr>
